# Exemple pour déploiement VM (Docker). Ne pas committer de vrais secrets.
#
# Deux fichiers sur la VM :
#   ~/quantum-bluff/.env          → QUANTUM_REGISTRY_IMAGE (voir .env.vm.example à la racine)
#   ~/quantum-bluff/server/.env   → secrets backend (copier ce fichier ou env.vm.server.copypaste)
#
# Recommandé : copier ce fichier vers server/.env (une seule fois sur la VM),
# puis éditer les valeurs. Le fichier server/.env est gitignored : un "git pull"
# ne l’écrase pas.
#
#   cp env.production.example server/.env
#   nano server/.env
#   docker compose -f docker-compose.prod.yml up -d --build backend
#
# Console admin (/auth/admin) : identifiants par défaut du projet (à changer si l’instance est exposée).
# Mot de passe en clair côté login : My027 — stocké ici uniquement en hash bcrypt.

DB_USER=admin
DB_PASSWORD=My027
DB_NAME=quantum_bluff

JWT_SECRET=change-me-min-32-chars-random-production

ADMIN_CONSOLE_USERNAME=admin
ADMIN_CONSOLE_PASSWORD_HASH=$2a$10$n63pLbhL.ATM6eK.haTCrOlZvjVeU06xTGkH624bbI54XfIQspPrG
ADMIN_CONSOLE_JWT_USER_ID=00000000-0000-4000-8000-000000000001

# CORS (obligatoire en prod) — liste séparée par des virgules (sans guillemets autour des URLs)
CORS_ORIGIN=https://quantum-bluff.com,https://www.quantum-bluff.com,https://mai-projet-integrateur.u-strasbg.fr

# Front Vercel (Environment → Production, au BUILD) — obligatoire pour l’audio des appels
# VITE_API_URL=https://api.quantum-bluff.com
# VITE_SOCKET_URL=https://api.quantum-bluff.com
#
# TURN obligatoire pour audio bidirectionnel entre réseaux différents (box ↔ 4G, NAT strict).
# Créer un compte Metered (ou autre TURN), puis coller le JSON en UNE ligne (sans guillemets externes) :
# VITE_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:global.relay.metered.ca:80","username":"VOTRE_USER","credential":"VOTRE_CREDENTIAL"},{"urls":"turn:global.relay.metered.ca:443","username":"VOTRE_USER","credential":"VOTRE_CREDENTIAL"},{"urls":"turns:global.relay.metered.ca:443?transport=tcp","username":"VOTRE_USER","credential":"VOTRE_CREDENTIAL"}]
# Après ajout/modif : redéployer le client Vercel (variable bake-in au build). Vérifier en prod : pas de warning console « sans TURN ».

# Supabase : utiliser l’URL « pooler » (port 6543, mode transaction) pour l’app Node.
# DATABASE_POOL_MAX=8 limite les connexions pg par instance Render (évite les requêtes à ~4s).
# DATABASE_POOL_MAX=8

# Optionnel si tu lances aussi le backend hors Docker avec ce même fichier :
# DATABASE_URL=postgresql://admin:change_me@localhost:5432/quantum_bluff
