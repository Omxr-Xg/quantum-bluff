# Exemple pour déploiement VM (Docker). Ne pas committer de vrais secrets.
#
# Recommandé : copier ce fichier vers server/.env (une seule fois sur la VM),
# puis éditer les valeurs. Le fichier server/.env est gitignored : un "git pull"
# ne l’écrase pas.
#
#   cp env.production.example server/.env
#   nano server/.env
#   docker compose -f docker-compose.prod.yml up -d --build backend
#
# Console admin (/auth/admin) : identifiants par défaut du projet (à changer si l’instance est exposée).
# Mot de passe en clair côté login : My027 — stocké ici uniquement en hash bcrypt.

DB_USER=admin
DB_PASSWORD=My027
DB_NAME=quantum_bluff

JWT_SECRET=change-me-min-32-chars-random-production

ADMIN_CONSOLE_USERNAME=admin
ADMIN_CONSOLE_PASSWORD_HASH=$2a$10$n63pLbhL.ATM6eK.haTCrOlZvjVeU06xTGkH624bbI54XfIQspPrG
ADMIN_CONSOLE_JWT_USER_ID=00000000-0000-4000-8000-000000000001

# Optionnel si tu lances aussi le backend hors Docker avec ce même fichier :
# DATABASE_URL=postgresql://admin:change_me@localhost:5432/quantum_bluff
