# Exemple pour déploiement Docker local / staging. Ne pas committer de vrais secrets.
#
# Production actuelle : client Vercel + API Render (Supabase).
# Copier vers server/.env (gitignored) :
#
#   cp env.production.example server/.env
#   nano server/.env

DB_USER=admin
DB_PASSWORD=change-me
DB_NAME=quantum_bluff

JWT_SECRET=change-me-min-32-chars-random-production

ADMIN_CONSOLE_USERNAME=admin
ADMIN_CONSOLE_PASSWORD_HASH=$2a$10$n63pLbhL.ATM6eK.haTCrOlZvjVeU06xTGkH624bbI54XfIQspPrG
ADMIN_CONSOLE_JWT_USER_ID=00000000-0000-4000-8000-000000000001

# CORS — origines du client web
CORS_ORIGIN=https://quantum-bluff.com,https://www.quantum-bluff.com

# Front Vercel (variables au BUILD sur Vercel → Production)
# VITE_API_URL=https://api.quantum-bluff.com
# VITE_SOCKET_URL=https://api.quantum-bluff.com
# VITE_SOCKET_PATH=/socket.io

# TURN WebRTC (optionnel, audio entre réseaux différents)
# VITE_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},...]

# Supabase pooler (port 6543) — DATABASE_POOL_MAX=8 recommandé sur Render
# DATABASE_URL=postgresql://...
