# Variables lues au runtime par electron.cjs (packager ou export avant `electron`).

# URL du jeu en prod (fenêtre Electron). Défaut : hébergeur école + préfixe VM.
# QB_PUBLIC_URL=https://mai-projet-integrateur.u-strasbg.fr/vmProjetIntegrateurgrp10-0

# Base des mises à jour (dossier /updates/ ajouté automatiquement). Défaut = QB_PUBLIC_URL.
# QB_UPDATES_BASE_URL=https://mai-projet-integrateur.u-strasbg.fr/vmProjetIntegrateurgrp10-0

# Dev : `npm run electron:dev` fixe NODE_ENV=development et charge Vite sur localhost:5175.
# Surcharge optionnelle :
# ELECTRON_DEV_URL=http://localhost:5175/vmProjetIntegrateurgrp10-0/
