# Build web (navigateur / PWA) — variables optionnelles.
# Par défaut, vite.config.ts utilise VITE_BASE_PATH=/vmProjetIntegrateurgrp10-0/

# Déploiement à la racine du domaine (sans préfixe VM) :
# VITE_BASE_PATH=/

# API absolue (optionnel) ; sinon requêtes relatives /api sur la même origine.
# VITE_API_URL=
# VITE_SOCKET_URL=
# VITE_SOCKET_PATH=/socket.io
