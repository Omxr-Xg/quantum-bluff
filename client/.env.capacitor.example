# Build natif : `npm run build:cap` (mode Vite = capacitor).
# Surcharges locales : `.env.capacitor.local` (gitignored).

VITE_BASE_PATH=/

# --- PROD (API Render) ---
VITE_API_URL=https://api.quantum-bluff.com
VITE_SOCKET_URL=https://api.quantum-bluff.com
VITE_SOCKET_PATH=/socket.io

# --- DEV local (backend sur la machine de dev) ---
# VITE_API_URL=http://192.168.x.x:3000
# VITE_SOCKET_URL=http://192.168.x.x:3000
# VITE_SOCKET_PATH=/socket.io
