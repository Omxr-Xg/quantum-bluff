# =============================================================================
# Android / iOS (Capacitor)
# 1. Copie ce fichier :  cp .env.capacitor.example .env.capacitor
# 2. Décommente le bloc PROD ci-dessous (ou garde-le tel quel si c’est ton déploiement).
# 3. Build : npm run build:cap && npx cap sync
# =============================================================================
#
# Pourquoi : dans l’app native, la page est servie depuis capacitor://localhost.
# Un VITE_API_URL du type /vmProjet... SEUL ne fonctionne pas : il faut une URL https COMPLÈTE
# (ou VITE_DEPLOY_ORIGIN + chemin relatif, voir bas du fichier).

# --- PROD — même hôte que le site https://mai-projet-integrateur.u-strasbg.fr/vmProjetIntegrateurgrp10-0/ ---
VITE_BASE_PATH=/
VITE_API_URL=https://mai-projet-integrateur.u-strasbg.fr/vmProjetIntegrateurgrp10-0
VITE_SOCKET_URL=https://mai-projet-integrateur.u-strasbg.fr/vmProjetIntegrateurgrp10-0
VITE_SOCKET_PATH=/vmProjetIntegrateurgrp10-0/socket.io

# --- Variante équivalente (décommente et commente le bloc ci-dessus si tu préfères) ---
# VITE_BASE_PATH=/
# VITE_DEPLOY_ORIGIN=https://mai-projet-integrateur.u-strasbg.fr
# VITE_API_URL=/vmProjetIntegrateurgrp10-0
# VITE_SOCKET_URL=https://mai-projet-integrateur.u-strasbg.fr/vmProjetIntegrateurgrp10-0
# VITE_SOCKET_PATH=/vmProjetIntegrateurgrp10-0/socket.io

# --- Backend direct sur ta machine (dev LAN uniquement) ---
# VITE_BASE_PATH=/
# VITE_API_URL=http://192.168.x.x:3000
# VITE_SOCKET_URL=http://192.168.x.x:3000
