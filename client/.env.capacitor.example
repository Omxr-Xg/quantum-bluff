# Copier vers .env.capacitor à la racine de client/ (fichier ignoré par git).
# Build : npm run build:cap && npx cap sync

# Base path Vite : "/" pour les apps natives (assets dans www).
VITE_BASE_PATH=/

# Obligatoire sur Capacitor : origine du backend (HTTP(S)).
# Exemple même hébergeur que le web (reverse proxy) :
# VITE_API_URL=https://mai-projet-integrateur.u-strasbg.fr/vmProjetIntegrateurgrp10-0
# Exemple backend direct (VM) :
# VITE_API_URL=http://192.168.x.x:3000

# Socket.IO : même base que l’API si le serveur écoute sur la même origine.
# VITE_SOCKET_URL=https://mai-projet-integrateur.u-strasbg.fr/vmProjetIntegrateurgrp10-0
# VITE_SOCKET_URL=http://192.168.x.x:3000

# Si l’API est derrière un préfixe Nginx (/vm.../) et pas en direct :8080,
# fixer le chemin Socket.IO explicite :
# VITE_SOCKET_PATH=/vmProjetIntegrateurgrp10-0/socket.io
