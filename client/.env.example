# API et Socket - pour Capacitor (mobile)
# En production mobile, utilise l'IP publique de ton serveur (localhost = le téléphone)
# VITE_API_URL=http://185.155.93.105:3000
# VITE_SOCKET_URL=http://185.155.93.105:3000

# WebRTC (appels vocaux) — en prod, ajouter un serveur TURN si l'audio ne passe pas entre réseaux
# VITE_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478","username":"user","credential":"secret"}]

# Base path - pour build Capacitor (racine /)
# VITE_BASE_PATH=/

# Capacitor dev - URL du serveur Vite pour livereload sur mobile
# CAPACITOR_SERVER_URL=http://185.155.93.105:5173

# AdSense — emplacements discrets (optionnel ; sans slot = rien en prod, placeholder en dev)
# VITE_ADSENSE_SLOT_LOBBY=1234567890
# VITE_ADSENSE_SLOT_PROFILE=1234567891
# VITE_ADSENSE_SLOT_GAMES=1234567892
