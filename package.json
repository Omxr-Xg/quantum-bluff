{
  "name": "quantum-bluff-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "install:all": "npm install && cd server && npm install && cd ../client && npm install",
    "dev": "concurrently -n \"DB,SERVER,CLIENT\" -c \"blue,magenta,cyan\" \"npm:dev:db\" \"npm:dev:server\" \"npm:dev:client\"",
    "dev:db": "cd database && sudo docker-compose up -d",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
