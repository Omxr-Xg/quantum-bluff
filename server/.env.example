# Copier vers .env et renseigner les valeurs (ne jamais committer .env).

# Local Docker (database/docker-compose.yml) :
DATABASE_URL="postgresql://admin:My027@localhost:5433/quantum_bluff?schema=public"
DIRECT_URL="postgresql://admin:My027@localhost:5433/quantum_bluff?schema=public"

# Supabase prod (exemple — remplacer [YOUR-PASSWORD], ne pas committer server/.env) :
# DATABASE_URL="postgresql://postgres.pfdjjdvhhyswuhhvejvo:[YOUR-PASSWORD]@aws-1-eu-north-1.pooler.supabase.com:6543/postgres?pgbouncer=true&schema=public"
# DIRECT_URL="postgresql://postgres.pfdjjdvhhyswuhhvejvo:[YOUR-PASSWORD]@aws-1-eu-north-1.pooler.supabase.com:5432/postgres?schema=public"
# RLS : migrations 20260529120000_* / 20260529130000_* + prisma/scripts/supabase-rls-hardening.sql
# (RLS + policy qb_deny_api_access sur public."User" etc. ; Prisma via postgres inchangé).
JWT_SECRET="change-me-min-32-chars-random"

# Redis — idempotence casino (SET NX + TTL), poker/blackjack stores optionnels
# REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

PORT=3000
NODE_ENV=development

# IA expert poker Python (optionnel). Si désactivé ou indisponible,
# le backend retombe automatiquement sur l'heuristique expert TypeScript.
# AI_SERVICE_ENABLED=true
# AI_SERVICE_URL=http://localhost:8000
# AI_SERVICE_TIMEOUT_MS=450
# Autoriser l'alimentation "dev" via le panneau solde même en NODE_ENV=production.
# Pour un rendu académique uniquement (désactiver en vrai prod).
# ALLOW_DEV_TOPUP=true

# Code promo secret (flux « alimenter le compte ») : montant fictif 0 € + crédit des jetons choisis.
# La valeur ne doit jamais figurer dans le frontend. Défaut interne si absent — surcharger en prod.
# FREE_TOPUP_PROMO_CODE=
# (alias historique) BALANCE_RESET_PROMO_CODE=

# CORS : tableau JSON ou liste séparée par des virgules (origines du site / Vite en dev).
# Les apps Capacitor envoient Origin: capacitor://localhost — le serveur les ajoute toujours automatiquement.
# CORS_ORIGIN=https://quantum-bluff.com,https://www.quantum-bluff.com
# CORS_EXTRA_ORIGIN=
# PUBLIC_APP_URL=https://quantum-bluff.com

# Override roulette admin — UNIQUEMENT hors production, depuis localhost.
# Ne pas activer sur une machine exposée au réseau : exiger requêtes 127.0.0.1/::1 + en-tête X-Admin-Token.
# ENABLE_ADMIN_ROULETTE_OVERRIDE=true
# ADMIN_API_TOKEN="long-random-token-min-8-chars"

# Console admin web (/auth/admin + /api/admin/console) — les deux variables ou aucune.
# Défaut projet : utilisateur admin, mot de passe My027 (hash bcrypt ci-dessous — ne pas mettre le mot de passe en clair ici).
ADMIN_CONSOLE_USERNAME="admin"
ADMIN_CONSOLE_PASSWORD_HASH="$2a$10$n63pLbhL.ATM6eK.haTCrOlZvjVeU06xTGkH624bbI54XfIQspPrG"
# Optionnel : sous du JWT (défaut ci-dessous)
ADMIN_CONSOLE_JWT_USER_ID="00000000-0000-4000-8000-000000000001"
#
# Déploiement VM (Docker) : copie env.production.example → server/.env sur la VM (une fois).
# Ce fichier est gitignored : git pull ne le supprime pas. docker-compose.prod.yml charge server/.env
# dans le conteneur backend (env_file). Sans ADMIN_CONSOLE_*, POST /api/auth/admin/login → 503.
# Sur VM avec docker compose : dans server/.env, doubler chaque $ du hash (ex. $$2a$$10$$…), sinon
# Compose interprète $2a / $10 comme des variables et le login admin casse après chaque recreate.
# En CI GitLab, définir ADMIN_CONSOLE_USERNAME + ADMIN_CONSOLE_PASSWORD_HASH (un seul $) : le job
# deploy:staging réécrit automatiquement server/.env à chaque déploiement.
# Alternative : ./scripts/compose-prod.sh -f docker-compose.prod.yml up -d --build
