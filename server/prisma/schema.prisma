// ============================================
// CODES CADEAUX & PROMOTIONS
// ============================================
model GiftCode {
  id          String    @id @default(uuid())
  code        String    @unique
  amount      Int // Valeur générique: jetons ou montant/pourcentage de réduction
  usageType   String    @default("TOKENS") // TOKENS | FIXED_DISCOUNT | PERCENTAGE_DISCOUNT
