generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  email     String   @unique
  password  String
  chips     Int      @default(1000)
  level     Int      @default(1)

  stats     UserStats?
  histories GameHistory[] @relation("WinnerHistory")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserStats {
  id          String @id @default(uuid())
  wins        Int    @default(0)
  totalGames  Int    @default(0)
  biggestPot  Int    @default(0)

  user        User   @relation(fields: [userId], references: [id])
  userId      String @unique
}

model GameHistory {
  id        String   @id @default(uuid())
  tableId   String
  gameId    String
  board     String[]
  pot       Int

  winner    User     @relation("WinnerHistory", fields: [winnerId], references: [id])
  winnerId  String

  createdAt DateTime @default(now())
}
