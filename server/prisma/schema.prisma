// ============================================
// PARIS CACHÉS POKER (cash game)
// ============================================

enum HiddenBetTicketStatus {
  PENDING
  SETTLING
  WON
  LOST
  VOID
  CANCELED
}

enum HiddenBetCombinator {
  SINGLE
  AND
}

enum HiddenBetMarketPhase {
  PRE_HAND
  LIVE_FLOP
  LIVE_TURN
  LIVE_RIVER
}

model HiddenBetTicket {
  id                  String                @id @default(uuid())
  userId              String
  gameId              String
  handId              String
  marketPhase         HiddenBetMarketPhase  @default(PRE_HAND)
  status              HiddenBetTicketStatus @default(PENDING)
  stake               Int
  quotedOdds          Float
  potentialPayout     Int
  currency            String                @default("CHIPS")
  combinator          HiddenBetCombinator   @default(SINGLE)
  placedAt            DateTime              @default(now())
  resolvedAt          DateTime?
  resolutionStartedAt DateTime?
  quoteExpiresAt      DateTime?
  actionId            String
  pricingVersion      String
  resolutionVersion   String                @default("hidden-bets-resolve-v1")
  resultSummaryJson   Json?
  stateSnapshotJson   Json?
  ticketHash          String?
  quoteHash           String?
  quotedProbability   Float?
  houseEdgeVersion    String?

  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  selections HiddenBetSelection[]

  @@unique([userId, actionId])
  @@index([userId, gameId, handId])
  @@index([gameId, handId, status])
  @@index([userId, status])
  @@index([gameId, handId, marketPhase])
  @@map("hidden_bet_tickets")
}

model HiddenBetSelection {
  id             String  @id @default(uuid())
  ticketId       String
  marketType     String
  marketKey      String
  paramSignature String
  paramsJson     String
  displayLabel   String?
  sequenceOrder  Int     @default(0)

  ticket HiddenBetTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@map("hidden_bet_selections")
}

/// Verrou idempotence : une seule résolution réussie par (gameId, handId).
model HiddenBetHandResolution {
  gameId     String
  handId     String
  resolvedAt DateTime @default(now())

  @@id([gameId, handId])
  @@map("hidden_bet_hand_resolutions")
}

model DailyChallengeProgress {
  id            String    @id @default(uuid())
  userId        String
  dayKey        String
  challengeCode String
  progress      Int       @default(0)
  goal          Int
  completed     Boolean   @default(false)
  claimed       Boolean   @default(false)
  rewardTokens  Int
  claimedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dayKey, challengeCode])
  @@index([userId, dayKey])
  @@index([dayKey, challengeCode])
  @@map("daily_challenge_progress")
}

// ============================================
// TOURNOIS TEXAS HOLD'EM (élimination directe)
// ============================================

enum TournamentVisibility {
  PUBLIC
  PRIVATE
}

enum TournamentStatus {
  REGISTRATION_OPEN
  STARTING
  ROUND_IN_PROGRESS
  WAITING_FOR_TABLES
  WAITING_READY_CHECK
  COMPLETED
  CANCELLED
}

enum TournamentPlayerStatus {
  REGISTERED
  ACTIVE
  WAITING_NEXT_ROUND
  ELIMINATED
  WINNER
}

enum TournamentRoundStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum TournamentTableStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
  RECOVERING
}

enum TournamentRewardLedgerKind {
  CHIPS_WINNER
  XP_PLACEMENT
}

model Tournament {
  id                        String               @id @default(uuid())
  name                      String
  hostId                    String
  host                      User                 @relation("TournamentHost", fields: [hostId], references: [id], onDelete: Cascade)
  visibility                TournamentVisibility @default(PUBLIC)
  /// Hash bcrypt du code (PRIVATE uniquement)
  codeHash                  String?
  status                    TournamentStatus     @default(REGISTRATION_OPEN)
  maxPlayers                Int /// 4–20
  initialStack              Int
  startAt                   DateTime
  blindSmall                Int
  blindBig                  Int
  currentRoundNumber        Int                  @default(0)
  bracketJson               Json?
  /// Snapshot au moment de la création de la table finale (JSON string[] userIds)
  finalTablePlayerIds       Json?
  finalTableInitialStackSum Int?
  /// Fenêtre ready-check ouverte entre deux manches (flag idempotent pour proceedToNextRound).
  nextRoundReadyOpen        Boolean              @default(false)
  /// Deadline d'auto-ready (timestamp T+30s à l'ouverture de la fenêtre courante).
  nextRoundReadyDeadline    DateTime?
  /// Numéro du round à venir (le NEXT, pas celui qui vient de finir). Permet de filtrer les lignes ready.
  nextRoundReadyNumber      Int?
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt

  players      TournamentPlayer[]
  rounds       TournamentRound[]
  rewards      TournamentRewardLedger[]
  roundReadies TournamentRoundReady[]
  winnerBets   TournamentWinnerBet[]

  @@index([status, startAt])
  @@index([hostId])
  @@map("tournaments")
}

model TournamentPlayer {
  id                    String                 @id @default(uuid())
  tournamentId          String
  userId                String
  status                TournamentPlayerStatus @default(REGISTERED)
  eliminatedAt          DateTime?
  finalRank             Int?
  eliminationOrder      Int?
  eliminatedFromTableId String?
  qualifiedRound        Int?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, userId])
  @@index([tournamentId, status])
  @@index([userId])
  @@map("tournament_players")
}

model TournamentRound {
  id           String                @id @default(uuid())
  tournamentId String
  roundNumber  Int
  status       TournamentRoundStatus @default(PENDING)
  startedAt    DateTime?
  completedAt  DateTime?

  tournament Tournament        @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  tables     TournamentTable[]

  @@unique([tournamentId, roundNumber])
  @@index([tournamentId, status])
  @@map("tournament_rounds")
}

model TournamentTable {
  id           String                @id @default(uuid())
  roundId      String
  gameId       String                @unique
  status       TournamentTableStatus @default(PENDING)
  winnerUserId String?
  playerCount  Int                   @default(0)
  isFinalTable Boolean               @default(false)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  round TournamentRound @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@index([roundId, status])
  @@index([gameId])
  @@map("tournament_tables")
}

model TournamentRewardLedger {
  id           String                     @id @default(uuid())
  tournamentId String
  userId       String
  kind         TournamentRewardLedgerKind
  chipsAmount  Int?
  xpDelta      Int?
  createdAt    DateTime                   @default(now())

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, userId, kind])
  @@index([tournamentId])
  @@map("tournament_reward_ledger")
}

/// Une ligne par survivant ayant cliqué « Prêt » pour la manche à venir.
/// Persisté pour idempotence (recovery + tick scheduler) et audit (autoReady).
model TournamentRoundReady {
  id           String   @id @default(uuid())
  tournamentId String
  /// Round à venir (le NEXT, pas celui qui vient de finir).
  roundNumber  Int
  userId       String
  readyAt      DateTime @default(now())
  autoReady    Boolean  @default(false)

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, roundNumber, userId])
  @@index([tournamentId, roundNumber])
  @@map("tournament_round_ready")
}

/// Statut d'un pari caché « vainqueur de tournoi ».
/// PENDING tant que le tournoi n'est pas terminé.
/// WON / LOST attribués lors du finalize (résolution parimutuel).
/// REFUNDED si tournoi annulé OU si personne n'a parié sur le vainqueur effectif (pot orphelin).
enum TournamentWinnerBetStatus {
  PENDING
  WON
  LOST
  REFUNDED
}

/// Paris cachés sur le futur vainqueur d'un tournoi (parimutuel dynamique).
/// Marché toujours ouvert tant que le tournoi est en cours (REGISTRATION_OPEN → ROUND_IN_PROGRESS…).
/// À la résolution : chaque gagnant reçoit `(stake / poolGagnant) * poolTotal` (entier, arrondi bas).
/// Plus de joueur prédit n'a survécu (ELIMINATED / KICKED) ⇒ pari LOST mécaniquement.
model TournamentWinnerBet {
  id                    String                    @id @default(uuid())
  tournamentId          String
  bettorUserId          String
  predictedWinnerUserId String
  stake                 Int
  status                TournamentWinnerBetStatus @default(PENDING)
  /// Net (= gain - mise) crédité au moment de la résolution. NULL tant que PENDING.
  payout                Int?
  /// Snapshot pris au placement pour usage analytics/affichage : pas utilisé pour le calcul final.
  oddsSnapshot          Float?
  resolvedAt            DateTime?
  placedAt              DateTime                  @default(now())

  tournament      Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  bettor          User       @relation("TournamentWinnerBetBettor", fields: [bettorUserId], references: [id], onDelete: Cascade)
  predictedWinner User       @relation("TournamentWinnerBetPredicted", fields: [predictedWinnerUserId], references: [id], onDelete: Cascade)

  @@index([tournamentId])
  @@index([tournamentId, status])
  @@index([tournamentId, predictedWinnerUserId])
  @@index([bettorUserId, placedAt])
  @@map("tournament_winner_bets")
}

// ============================================
// PARRAINAGE
// ============================================

enum ReferralStatus {
