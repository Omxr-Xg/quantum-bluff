  "description": "Quantum Bluff Backend",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "prisma generate && nodemon --watch src --watch prisma --ext ts,json,prisma --ignore src/generated --exec tsx src/devBoot.ts",
    "postinstall": "prisma generate",
    "build": "prisma generate && tsc && cp -r src/generated dist/",
    "lint": "eslint . --no-cache",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "load-test": "tsx src/scripts/loadTest.ts",
    "load-test:ci": "bash scripts/ci-stress-test.sh",
    "db:supabase-rls": "prisma db execute --file prisma/scripts/supabase-advisors-fix-all.sql --url \"${DIRECT_URL:-$DATABASE_URL}\""
  },
