# Staging — copier vers server/.env.staging (ne pas committer les secrets).
# Flux : develop → staging (Render preview + Vercel preview) → production

NODE_ENV=staging

# Projet Supabase STAGING dédié (pas la prod !)
DATABASE_URL="postgresql://postgres.[ref]:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true&schema=public"
DIRECT_URL="postgresql://postgres.[ref]:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres?schema=public"

JWT_SECRET="change-me-staging-min-32-chars"

# Origines du front staging (Vercel preview ou sous-domaine dédié)
CORS_ORIGIN=https://staging.quantum-bluff.com,https://quantum-bluff-staging.vercel.app

# Observabilité
SENTRY_DSN=
SENTRY_ENVIRONMENT=staging
SENTRY_TRACES_SAMPLE_RATE=0.2

# Redis staging (optionnel — Upstash instance séparée)
# REDIS_URL=

INSTANCE_COUNT=1
