# Copier sur la VM vers server/.env (ou fusionner avec ton fichier existant).
# Console admin : utilisateur admin, mot de passe My027 (hash bcrypt ci-dessous).
# Adapter CORS_ORIGIN et JWT_SECRET si besoin.

NODE_ENV=production
PORT=3000

# Base — hôtes postgres / redis = noms des services Docker (docker-compose.prod.yml)
DATABASE_URL="postgresql://admin:My027@postgres:5432/quantum_bluff?schema=public"

REDIS_URL=redis://redis:6379
REDIS_HOST=redis
REDIS_PORT=6379

# À changer en prod réelle (min. ~32 caractères aléatoires)
JWT_SECRET="quantum_bluff_vm_change_me_use_openssl_rand_hex_32"

# Origine du front (web). Remplace par ton URL si différente.
CORS_ORIGIN="https://mai-projet-integrateur.u-strasbg.fr"

# Console admin web (/auth/admin) — mot de passe en clair au login : My027
ADMIN_CONSOLE_USERNAME=admin
# Docker Compose (env_file) : doubler chaque $ du hash bcrypt, sinon le hash est corrompu à chaque up.
ADMIN_CONSOLE_PASSWORD_HASH=$$2a$$10$$n63pLbhL.ATM6eK.haTCrOlZvjVeU06xTGkH624bbI54XfIQspPrG
ADMIN_CONSOLE_JWT_USER_ID=00000000-0000-4000-8000-000000000001
TRUST_PROXY=2

# Même couple user/mdp que Postgres du compose (variables utiles si tu ajoutes un .env à la racine pour docker compose)
DB_USER=admin
DB_PASSWORD=My027
DB_NAME=quantum_bluff

# IA Python (aligné sur docker-compose.prod.yml)
AI_SERVICE_ENABLED=true
AI_SERVICE_URL=http://ai-service:8000
AI_SERVICE_TIMEOUT_MS=450
