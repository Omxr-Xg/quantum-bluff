# Copier à la racine du repo sur la VM :  cp .env.vm.example .env
# Utilisé par docker compose -f docker-compose.prod.yml -f docker-compose.vm-registry.yml
#
# URL du Container Registry GitLab (GitLab → Deploy → Container Registry, sans tag).
# Projet Unistra :
QUANTUM_REGISTRY_IMAGE=registry.git.unistra.fr/aguech/quantum-bluff

# Optionnel : surchargés aussi par deploy:staging depuis les variables CI GitLab
# JWT_SECRET=
# DATABASE_URL=
